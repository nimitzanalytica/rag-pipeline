# Copy this file to .env and fill in your values
# cp .env.example .env

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose "ollama" (free, local, private) or "claude" (Anthropic API)
LLM_PROVIDER=ollama

# ── Option A: Ollama (default) ────────────────────────────────────────────────
# Free, runs entirely on your machine — no API key needed
# 1. Install Ollama: https://ollama.com
# 2. Pull a model: ollama pull llama3.2
# 3. Set LLM_PROVIDER=ollama above (already the default)
#
# OLLAMA_MODEL=llama3.2

# ── Option B: Anthropic Claude ────────────────────────────────────────────────
# Requires a paid Anthropic API key: https://console.anthropic.com
# 1. Set LLM_PROVIDER=claude above
# 2. Add your key below
#
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── PostgreSQL Query Logging ──────────────────────────────────────────────────
# Every query and answer is logged to PostgreSQL for auditing and analytics.
# Install PostgreSQL: https://www.postgresql.org/download/
# Create the database: CREATE DATABASE rag_pipeline;
#
DB_HOST=localhost
DB_PORT=5433
DB_NAME=rag_pipeline
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ── Optional overrides (defaults shown) ───────────────────────────────────────
# MAX_TOKENS=1024
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# RETRIEVAL_K=4
